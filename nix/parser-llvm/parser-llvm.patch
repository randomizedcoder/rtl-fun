+// rtl-fun parser-unit: the p-register file (Cpreg[28:24], p0..p31) selected by the
+// custom-3 moves (RISCVInstrInfoXparser.td, generated from isa/parser-opcodes.yaml).
+// The generated decoder references this by the register class name; p0..p31 are defined
+// consecutively so `RISCV::P0 + RegNo` is the matching physical register.
+static DecodeStatus DecodePRRegRegisterClass(MCInst &Inst, uint32_t RegNo,
+                                             uint64_t Address,
+                                             const MCDisassembler *Decoder) {
+  if (RegNo >= 32)
+    return MCDisassembler::Fail;
+
+  Inst.addOperand(MCOperand::createReg(RISCV::P0 + RegNo));
+  return MCDisassembler::Success;
+}
