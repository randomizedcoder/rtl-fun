       set file "src/nexys_video.svh"
       set registers "../../vendor/pulp-platform/common_cells/include/common_cells/registers.svh"
+} elseif {$::env(BOARD) eq "ax7325b"} {
+      read_verilog -sv {src/ax7325b.svh ../../vendor/pulp-platform/common_cells/include/common_cells/registers.svh}
+      set file "src/ax7325b.svh"
+      set registers "../../vendor/pulp-platform/common_cells/include/common_cells/registers.svh"
 } else {
     exit 1
 }
@@ -98,6 +104,17 @@
 report_cdc                                                              -file reports/$project.cdc.rpt
 report_clock_interaction                                                -file reports/$project.clock_interaction.rpt
 
+# STAGE=synth early-exit (verify-before-buy build-check): stop after synthesis and
+# the post-synth reports (utilization + timing estimate), skipping impl/bitstream.
+# The AX7325B pin/bank sign-off (impl) genuinely needs the board — its .xdc pins
+# carry #VERIFY markers — so its port is validated synth-only pre-buy. When STAGE
+# is unset (the turnkey default, e.g. genesys2) the full synth->impl->bitstream
+# flow runs unchanged.
+if {[info exists ::env(STAGE)] && $::env(STAGE) eq "synth"} {
+    puts "STAGE=synth: synthesis + reports complete, skipping implementation/bitstream."
+    exit 0
+}
+
 # set for RuntimeOptimized implementation
 set_property "steps.place_design.args.directive" "RuntimeOptimized" [get_runs impl_1]
 set_property "steps.route_design.args.directive" "RuntimeOptimized" [get_runs impl_1]
