--- a/Makefile
+++ b/Makefile
@@ -86,6 +86,13 @@
 	XILINX_PART              := xc7a200tsbg484-1
 	XILINX_BOARD             := digilentinc.com:nexys_video:part0:1.1
 	CLK_PERIOD_NS            := 40
+else ifeq ($(BOARD), ax7325b)
+	# ALINX AX7325B: same die/package/speed as Genesys 2 / KC705 (xc7k325tffg900-2).
+	# XILINX_BOARD is cosmetic here — the flow is board-file-free/part-only (ALINX
+	# boards are not in Vivado's board store); set_property board_part is neutralised.
+	XILINX_PART              := xc7k325tffg900-2
+	XILINX_BOARD             := alinx.com:ax7325b:part0:1.0
+	CLK_PERIOD_NS            := 20
 else
 $(error Unknown board - please specify a supported FPGA board)
 endif
@@ -783,6 +790,11 @@
 src/bootrom/bootrom_$(XLEN).sv:
 	$(MAKE) -C corev_apu/fpga/src/bootrom BOARD=$(BOARD) XLEN=$(XLEN) PLATFORM=$(PLATFORM) bootrom_$(XLEN).sv
 
+# FPGA_TARGET selects the inner corev_apu/fpga make goal: `all` (default) runs the
+# full synth->impl->bitstream->mcs flow; `synth` stops after synthesis + reports
+# (used with STAGE=synth for a verify-before-buy build-check, e.g. the AX7325B port
+# whose pin/bank impl sign-off needs the physical board).
+FPGA_TARGET ?= all
 fpga: $(ariane_pkg) $(src) $(fpga_src) $(uart_src) $(src_flist)
 	@echo "[FPGA] Generate sources"
 	@echo read_vhdl        {$(uart_src)}    > corev_apu/fpga/scripts/add_sources.tcl
@@ -791,7 +803,7 @@
 	@echo read_verilog -sv {$(filter-out $(fpga_filter), $(src))} 	   >> corev_apu/fpga/scripts/add_sources.tcl
 	@echo read_verilog -sv {$(fpga_src)}   >> corev_apu/fpga/scripts/add_sources.tcl
 	@echo "[FPGA] Generate Bitstream"
-	$(MAKE) -C corev_apu/fpga BOARD=$(BOARD) XILINX_PART=$(XILINX_PART) XILINX_BOARD=$(XILINX_BOARD) CLK_PERIOD_NS=$(CLK_PERIOD_NS)
+	$(MAKE) -C corev_apu/fpga $(FPGA_TARGET) BOARD=$(BOARD) XILINX_PART=$(XILINX_PART) XILINX_BOARD=$(XILINX_BOARD) CLK_PERIOD_NS=$(CLK_PERIOD_NS)
 
 altera: PLATFORM := "PLAT_AGILEX"
 
--- a/corev_apu/fpga/Makefile
+++ b/corev_apu/fpga/Makefile
@@ -28,6 +28,13 @@
 	$(VIVADO) $(VIVADOFLAGS) -source scripts/run.tcl
 	cp ariane.runs/impl_1/ariane_xilinx* ./$(work-dir)
 
+# synth-only build-check: build the IPs + run synthesis (run.tcl honours STAGE=synth
+# to stop after synth + reports). No impl, no bitstream copy, no mcs — so no board
+# pin/bank sign-off is required. Used by the AX7325B verify-before-buy target.
+synth: $(ips)
+	mkdir -p $(work-dir)
+	$(VIVADO) $(VIVADOFLAGS) -source scripts/run.tcl
+
 $(ips): %.xci :
 	mkdir -p $(work-dir)
 	@echo Generating $(@F)
