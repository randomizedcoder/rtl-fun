diff --git a/gas/config/tc-riscv.c b/gas/config/tc-riscv.c
index 6bcf538..6b9be82 100644
--- a/gas/config/tc-riscv.c
+++ b/gas/config/tc-riscv.c
@@ -1771,6 +1771,30 @@ validate_riscv_insn (const struct riscv_opcode *opc, int length)
 		    goto unknown_validate_operand;
 		}
 		break;
+	    case 'p': /* Vendor-specific (rtl-fun parser-unit) operands.  */
+	      switch (*++oparg)
+		{
+		case 'r': USE_IMM (5, 24); break; /* p-register, Cpreg[28:24].  */
+		case 'o': /* pcurptr+N displacement, 'XpoN@S' (load Offset).  */
+		case 'a': /* paccum[i] index, 'XpaN@S' (Pos).  */
+		  {
+		    size_t n, s;
+		    n = strtol (oparg + 1, (char **)&oparg, 10);
+		    if (*oparg != '@')
+		      goto unknown_validate_operand;
+		    s = strtol (oparg + 1, (char **)&oparg, 10);
+		    oparg--;
+		    USE_IMM (n, s);
+		    break;
+		  }
+		case 'm': /* value:mask, 'Xpm' -> Value[26:19] + Mask[18:11].  */
+		  USE_IMM (8, 19);
+		  USE_IMM (8, 11);
+		  break;
+		default:
+		  goto unknown_validate_operand;
+		}
+	      break;
 	    default:
 	      goto unknown_validate_operand;
 	    }
@@ -4287,6 +4311,125 @@ riscv_ip (char *str, struct riscv_cl_insn *ip, expressionS *imm_expr,
 		    }
 		  break;
 
+		case 'p': /* Vendor-specific (rtl-fun parser-unit) operands.  */
+		  switch (*++oparg)
+		    {
+		    case 'r': /* Parser p-register, Cpreg[28:24]: pNN or an alias.  */
+		      {
+			/* Names mirror isa/parser-opcodes.yaml p_registers.  */
+			static const struct { const char *name; unsigned num; } pregs[] = {
+			  {"pcurhdr", 1}, {"pdathdr", 2}, {"pnodeloop", 6},
+			  {"pcounters", 7}, {"pnextpc", 8}, {"pdone", 9},
+			  {"pnext", 11}, {"pdatabnd", 13}, {"pexitcode", 14},
+			  {"paccum", 15}, {"pflags", 16},
+			};
+			char *e = asarg;
+			unsigned regno = 32;
+			size_t k, len;
+			while (ISALNUM ((unsigned char) *e))
+			  e++;
+			len = e - asarg;
+			for (k = 0; k < ARRAY_SIZE (pregs); k++)
+			  if (strlen (pregs[k].name) == len
+			      && strncmp (asarg, pregs[k].name, len) == 0)
+			    {
+			      regno = pregs[k].num;
+			      break;
+			    }
+			if (regno == 32 && len >= 2 && asarg[0] == 'p'
+			    && ISDIGIT ((unsigned char) asarg[1]))
+			  regno = atoi (asarg + 1);
+			if (regno > 31)
+			  {
+			    as_bad (_("bad parser p-register `%.*s'"),
+				    (int) len, asarg);
+			    break;
+			  }
+			INSERT_IMM (5, 24, *ip, regno);
+			asarg = e;
+			continue;
+		      }
+		    case 'o': /* pcurptr+N displacement, 'XpoN@S' (load Offset).  */
+		      {
+			/* The `pcurptr` base is implicit (X=0, fixed) — pure
+			   decoration; absence means this is the Hybrid form, so
+			   fall through (break) to the next opcode row silently.  */
+			size_t n, s;
+			n = strtol (oparg + 1, (char **)&oparg, 10);
+			if (*oparg != '@')
+			  goto unknown_riscv_ip_operand;
+			s = strtol (oparg + 1, (char **)&oparg, 10);
+			oparg--;
+			if (strncmp (asarg, "pcurptr", 7) != 0)
+			  break;
+			asarg += 7;
+			if (*asarg == '+')
+			  {
+			    asarg++;
+			    my_getExpression (imm_expr, asarg, force_reloc);
+			    check_absolute_expr (ip, imm_expr, false);
+			    if (!VALIDATE_U_IMM (imm_expr->X_add_number, n))
+			      as_bad (_("improper pcurptr offset (%"PRIu64")"),
+				      imm_expr->X_add_number);
+			    INSERT_IMM (n, s, *ip, imm_expr->X_add_number);
+			    imm_expr->X_op = O_absent;
+			    asarg = expr_parse_end;
+			  }
+			/* else bare `pcurptr` -> Offset 0 (already in match).  */
+			continue;
+		      }
+		    case 'a': /* paccum[i] sub-register index, 'XpaN@S' (Pos).  */
+		      {
+			size_t n, s;
+			n = strtol (oparg + 1, (char **)&oparg, 10);
+			if (*oparg != '@')
+			  goto unknown_riscv_ip_operand;
+			s = strtol (oparg + 1, (char **)&oparg, 10);
+			oparg--;
+			if (strncmp (asarg, "paccum", 6) != 0)
+			  break;      /* Hybrid form -> next opcode row.  */
+			asarg += 6;
+			if (*asarg != '[')
+			  break;
+			asarg++;
+			my_getExpression (imm_expr, asarg, force_reloc);
+			check_absolute_expr (ip, imm_expr, false);
+			if (!VALIDATE_U_IMM (imm_expr->X_add_number, n))
+			  as_bad (_("improper paccum index (%"PRIu64")"),
+				  imm_expr->X_add_number);
+			INSERT_IMM (n, s, *ip, imm_expr->X_add_number);
+			imm_expr->X_op = O_absent;
+			asarg = expr_parse_end;
+			if (*asarg != ']')
+			  break;
+			asarg++;
+			continue;
+		      }
+		    case 'm': /* value:mask, 'Xpm' -> Value[26:19] + Mask[18:11].  */
+		      my_getExpression (imm_expr, asarg, force_reloc);
+		      check_absolute_expr (ip, imm_expr, false);
+		      if (!VALIDATE_U_IMM (imm_expr->X_add_number, 8))
+			as_bad (_("improper compare value (%"PRIu64")"),
+				imm_expr->X_add_number);
+		      INSERT_IMM (8, 19, *ip, imm_expr->X_add_number);
+		      asarg = expr_parse_end;
+		      if (*asarg != ':')
+			break;
+		      asarg++;
+		      my_getExpression (imm_expr, asarg, force_reloc);
+		      check_absolute_expr (ip, imm_expr, false);
+		      if (!VALIDATE_U_IMM (imm_expr->X_add_number, 8))
+			as_bad (_("improper compare mask (%"PRIu64")"),
+				imm_expr->X_add_number);
+		      INSERT_IMM (8, 11, *ip, imm_expr->X_add_number);
+		      imm_expr->X_op = O_absent;
+		      asarg = expr_parse_end;
+		      continue;
+		    default:
+		      goto unknown_riscv_ip_operand;
+		    }
+		  break;
+
 		default:
 		  goto unknown_riscv_ip_operand;
 		}
diff --git a/opcodes/riscv-dis.c b/opcodes/riscv-dis.c
index 03c8cf1..72bd0de 100644
--- a/opcodes/riscv-dis.c
+++ b/opcodes/riscv-dis.c
@@ -917,6 +917,77 @@ print_insn_args (const char *oparg, insn_t l, bfd_vma pc, disassemble_info *info
 		  goto undefined_modifier;
 		}
 	      break;
+	    case 'p': /* Vendor-specific (rtl-fun parser-unit) operands.  */
+	      switch (*++oparg)
+		{
+		case 'r': /* Parser p-register, Cpreg[28:24].  */
+		  {
+		    /* Names mirror isa/parser-opcodes.yaml p_registers.  */
+		    static const struct { const char *name; unsigned num; } pregs[] = {
+		      {"pcurhdr", 1}, {"pdathdr", 2}, {"pnodeloop", 6},
+		      {"pcounters", 7}, {"pnextpc", 8}, {"pdone", 9},
+		      {"pnext", 11}, {"pdatabnd", 13}, {"pexitcode", 14},
+		      {"paccum", 15}, {"pflags", 16},
+		    };
+		    unsigned regno = (unsigned) EXTRACT_U_IMM (5, 24, l);
+		    const char *nm = NULL;
+		    size_t k;
+		    for (k = 0; k < ARRAY_SIZE (pregs); k++)
+		      if (pregs[k].num == regno)
+			{
+			  nm = pregs[k].name;
+			  break;
+			}
+		    if (nm)
+		      print (info->stream, dis_style_register, "%s", nm);
+		    else
+		      print (info->stream, dis_style_register, "p%u", regno);
+		    break;
+		  }
+		case 'o': /* pcurptr+N displacement, 'XpoN@S' (load Offset).  */
+		  {
+		    size_t n, s;
+		    unsigned long v;
+		    n = strtol (oparg + 1, (char **)&oparg, 10);
+		    if (*oparg != '@')
+		      goto undefined_modifier;
+		    s = strtol (oparg + 1, (char **)&oparg, 10);
+		    oparg--;
+		    v = (unsigned long) EXTRACT_U_IMM (n, s, l);
+		    print (info->stream, dis_style_register, "pcurptr");
+		    if (v != 0)
+		      {
+			print (info->stream, dis_style_text, "+");
+			print (info->stream, dis_style_immediate, "%lu", v);
+		      }
+		    break;
+		  }
+		case 'a': /* paccum[i] sub-register index, 'XpaN@S' (Pos).  */
+		  {
+		    size_t n, s;
+		    n = strtol (oparg + 1, (char **)&oparg, 10);
+		    if (*oparg != '@')
+		      goto undefined_modifier;
+		    s = strtol (oparg + 1, (char **)&oparg, 10);
+		    oparg--;
+		    print (info->stream, dis_style_register, "paccum");
+		    print (info->stream, dis_style_text, "[");
+		    print (info->stream, dis_style_immediate, "%lu",
+			   (unsigned long) EXTRACT_U_IMM (n, s, l));
+		    print (info->stream, dis_style_text, "]");
+		    break;
+		  }
+		case 'm': /* value:mask -> Value[26:19] + Mask[18:11].  */
+		  print (info->stream, dis_style_immediate, "0x%lx",
+			 (unsigned long) EXTRACT_U_IMM (8, 19, l));
+		  print (info->stream, dis_style_text, ":");
+		  print (info->stream, dis_style_immediate, "0x%lx",
+			 (unsigned long) EXTRACT_U_IMM (8, 11, l));
+		  break;
+		default:
+		  goto undefined_modifier;
+		}
+	      break;
 	    default:
 	      goto undefined_modifier;
 	    }
