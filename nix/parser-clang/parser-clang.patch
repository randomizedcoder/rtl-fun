diff --git a/lib/CodeGen/TargetBuiltins/RISCV.cpp b/lib/CodeGen/TargetBuiltins/RISCV.cpp
index 99194cd7..6b6f3273 100644
--- a/lib/CodeGen/TargetBuiltins/RISCV.cpp
+++ b/lib/CodeGen/TargetBuiltins/RISCV.cpp
@@ -12,6 +12,7 @@
 
 #include "CodeGenFunction.h"
 #include "clang/Basic/TargetBuiltins.h"
+#include "llvm/IR/InlineAsm.h"
 #include "llvm/IR/IntrinsicsRISCV.h"
 #include "llvm/TargetParser/RISCVISAInfo.h"
 #include "llvm/TargetParser/RISCVTargetParser.h"
@@ -1124,6 +1125,79 @@ Value *CodeGenFunction::EmitRISCVBuiltinExpr(unsigned BuiltinID,
     Ops.push_back(EmitScalarOrConstFoldImmArg(ICEArguments, i, E));
   }
 
+  // rtl-fun parser extension: each __builtin_riscv_prs_* lowers to an operand-less
+  // `asm volatile("<prs.* mnemonic> $0, ...")` with `i` operands — the immediates print
+  // as literals (no register, naked-safe) and the mnemonic is assembled by the parser-
+  // patched RISCV MC layer. Table generated from isa/parser-opcodes.yaml (Phase 7 C1).
+  {
+    static const struct {
+      unsigned BuiltinID;
+      const char *Asm;
+      unsigned NumOps;
+    } ParserBuiltins[] = {
+#define PARSER_BUILTIN_LOWER(ID, ASM, NOPS)                                     \
+  {RISCV::BI__builtin_riscv_##ID, ASM, NOPS},
+#include "clang/Basic/parser-clang-builtins.inc"
+    };
+    for (const auto &PB : ParserBuiltins) {
+      if (PB.BuiltinID != BuiltinID)
+        continue;
+      llvm::SmallVector<llvm::Type *, 4> ArgTys;
+      llvm::SmallVector<llvm::Value *, 4> AsmArgs;
+      std::string Constraints;
+      for (unsigned k = 0; k < PB.NumOps; ++k) {
+        AsmArgs.push_back(Ops[k]);
+        ArgTys.push_back(Ops[k]->getType());
+        Constraints += (k ? ",i" : "i");
+      }
+      llvm::FunctionType *FTy = llvm::FunctionType::get(VoidTy, ArgTys, false);
+      llvm::InlineAsm *IA = llvm::InlineAsm::get(FTy, PB.Asm, Constraints,
+                                                 /*hasSideEffects=*/true);
+      return Builder.CreateCall(IA, AsmArgs);
+    }
+  }
+
+  // rtl-fun parser extension: the custom-3 register-operand moves (Phase 7 C3). Unlike the
+  // immediate-only C0 builtins above, these carry real GPR operands: arg 0 is the _Constant
+  // p-register (baked into the asm as `p<N>`), the read's rd is an `=r` output (the builtin's
+  // return value) and the write's rs is an `r` input. Separate table/arm so the C0 lowering
+  // stays byte-identical. Table generated from isa/parser-opcodes.yaml.
+  {
+    static const struct {
+      unsigned BuiltinID;
+      const char *Asm;
+      const char *Constraints;
+      bool HasOut;
+    } ParserRegBuiltins[] = {
+#define PARSER_BUILTIN_LOWER_REG(ID, ASM, CONS, HASOUT)                         \
+  {RISCV::BI__builtin_riscv_##ID, ASM, CONS, HASOUT},
+#include "clang/Basic/parser-clang-builtins.inc"
+    };
+    for (const auto &PB : ParserRegBuiltins) {
+      if (PB.BuiltinID != BuiltinID)
+        continue;
+      // Bake the constant p-register selector into the mnemonic: "{preg}" -> "pN".
+      uint64_t Preg = cast<llvm::ConstantInt>(Ops[0])->getZExtValue();
+      std::string Asm = PB.Asm;
+      std::string::size_type Pos = Asm.find("{preg}");
+      if (Pos != std::string::npos)
+        Asm.replace(Pos, 6, "p" + std::to_string(Preg));
+      // The GPR value operands (Ops[1..]) become the `r` inputs; the read output (if any) is
+      // the return value, not an argument.
+      llvm::SmallVector<llvm::Type *, 2> ArgTys;
+      llvm::SmallVector<llvm::Value *, 2> AsmArgs;
+      for (unsigned k = 1; k < Ops.size(); ++k) {
+        AsmArgs.push_back(Ops[k]);
+        ArgTys.push_back(Ops[k]->getType());
+      }
+      llvm::Type *RetTy = PB.HasOut ? Int64Ty : VoidTy;
+      llvm::FunctionType *FTy = llvm::FunctionType::get(RetTy, ArgTys, false);
+      llvm::InlineAsm *IA = llvm::InlineAsm::get(FTy, Asm, PB.Constraints,
+                                                 /*hasSideEffects=*/true);
+      return Builder.CreateCall(IA, AsmArgs);
+    }
+  }
+
   Intrinsic::ID ID = Intrinsic::not_intrinsic;
   int PolicyAttrs = 0;
   bool IsMasked = false;
