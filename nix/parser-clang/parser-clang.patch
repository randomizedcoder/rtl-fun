+  // rtl-fun parser extension: range-check the immediate operands of every
+  // __builtin_riscv_prs_* against its encoding field width. Table generated from
+  // isa/parser-opcodes.yaml (Phase 7 C1); each field is an unsigned [0, 2^w - 1].
+  {
+    bool Matched = false, Failed = false;
+#define PARSER_BUILTIN_RANGE(ID, ARG, MIN, MAX)                                 \
+  if (BuiltinID == RISCV::BI__builtin_riscv_##ID) {                             \
+    Matched = true;                                                             \
+    Failed |= SemaRef.BuiltinConstantArgRange(TheCall, ARG, MIN, MAX);         \
+  }
+#include "clang/Basic/parser-clang-builtins.inc"
+    if (Matched)
+      return Failed;
+  }
