diff --git a/corev_apu/tb/ariane_testharness.sv b/corev_apu/tb/ariane_testharness.sv
index 12c38a0..15d3f21 100644
--- a/corev_apu/tb/ariane_testharness.sv
+++ b/corev_apu/tb/ariane_testharness.sv
@@ -368,6 +368,101 @@ module ariane_testharness #(
     .rdata_o    ( rom_rdata )
   );
 
+  // ---------------
+  // Parser MMIO (I5) — closes the deferred packet-feed / flow_keys-readback escalation
+  // ---------------
+  // A real SoC slave at ariane_soc::ParserBase (0x5000_0000) so a bare-metal program
+  // can `sd` the packet bytes into the parser FU's packet buffer, program ParseLen, and
+  // `ld` the committed flow_keys back out — the substrate the table-driven cosim needs
+  // (docs/analysis/cva6-verification-design.md §1). axi2mem turns the AXI slave port
+  // into a simple req/we/addr/be/wdata + rdata port (same adapter as the bootrom/DRAM);
+  // a small decode routes it to the write/read ports threaded down into the parser FU.
+  //
+  //   window offset (within ParserBase + 0x0000..0x0FFF):
+  //     0x000..0x0FF   packet buffer   (write; byte offset = offset, 64-bit sd + strb)
+  //     0x100          ParseLen        (write; low 16 bits = PktLen.ParseLen)
+  //     0x200..0x23F   flow_keys frame (read;  meta offset = offset - 0x200, 64-bit ld)
+  logic                         parser_mmio_req, parser_mmio_we;
+  logic [AXI_ADDRESS_WIDTH-1:0] parser_mmio_addr;
+  logic [AXI_DATA_WIDTH/8-1:0]  parser_mmio_be;
+  logic [AXI_DATA_WIDTH-1:0]    parser_mmio_wdata;
+  logic [AXI_DATA_WIDTH-1:0]    parser_mmio_rdata;
+
+  axi2mem #(
+    .AXI_ID_WIDTH   ( ariane_axi_soc::IdWidthSlave ),
+    .AXI_ADDR_WIDTH ( AXI_ADDRESS_WIDTH            ),
+    .AXI_DATA_WIDTH ( AXI_DATA_WIDTH               ),
+    .AXI_USER_WIDTH ( AXI_USER_WIDTH               )
+  ) i_parser_axi2mem (
+    .clk_i  ( clk_i                      ),
+    .rst_ni ( ndmreset_n                 ),
+    .slave  ( master[ariane_soc::Parser] ),
+    .req_o  ( parser_mmio_req            ),
+    .we_o   ( parser_mmio_we             ),
+    .addr_o ( parser_mmio_addr           ),
+    .be_o   ( parser_mmio_be             ),
+    .user_o (                            ),
+    .data_o ( parser_mmio_wdata          ),
+    .user_i ( '0                         ),
+    .data_i ( parser_mmio_rdata          )
+  );
+
+  // window offset (ParserBase is 4KB-aligned ⇒ the low 12 bits ARE the offset)
+  logic [11:0] parser_off;
+  assign parser_off = parser_mmio_addr[11:0];
+
+  // decode: packet write / ParseLen write / metadata read
+  logic                             parser_pkt_wr_en;
+  logic [parser_pkg::PKT_OFF_W-1:0] parser_pkt_wr_addr;
+  logic [7:0]                       parser_pkt_wr_be;
+  logic [63:0]                      parser_pkt_wr_data;
+  logic [15:0]                      parser_parse_len_q;
+  logic [63:0]                      parser_exit_pc_q;
+  logic [parser_pkg::META_OFF_W-1:0] parser_meta_rd_addr;
+  logic [63:0]                      parser_meta_rd_data;
+  logic [63:0]                      parser_status;
+
+  wire parser_wr_pkt  = parser_mmio_req &  parser_mmio_we & (parser_off <  12'h100);
+  wire parser_wr_plen = parser_mmio_req &  parser_mmio_we & (parser_off == 12'h100);
+  wire parser_wr_expc = parser_mmio_req &  parser_mmio_we & (parser_off == 12'h108);
+
+  assign parser_pkt_wr_en   = parser_wr_pkt;
+  assign parser_pkt_wr_addr = parser_off[parser_pkg::PKT_OFF_W-1:0];
+  assign parser_pkt_wr_be   = parser_mmio_be;
+  assign parser_pkt_wr_data = parser_mmio_wdata;
+  assign parser_meta_rd_addr = (parser_off - 12'h200) < 12'(parser_pkg::META_MAX)
+                             ? (parser_off - 12'h200) : '0;
+  // read decode: 0x100 => latched exit status, 0x200.. => flow_keys, else 0.
+  // REGISTERED (synchronous-memory semantics): axi2mem expects a 1-cycle-latency
+  // memory. In its READ state it combinationally advances addr_o to the NEXT beat
+  // address the moment r_ready is high (axi2mem.sv ~line 193: `addr_o = cons_addr`),
+  // so a COMBINATIONAL data_i re-settles to mem[ar_addr + 8] and a single `ld` returns
+  // the wrong word. The bootrom/DRAM avoid this by using registered SRAMs; we do the
+  // same here — register rdata so the beat's data tracks the address presented in IDLE
+  // (ar_addr), immune to that same-cycle reassignment.
+  logic [63:0] parser_mmio_rdata_d, parser_mmio_rdata_q;
+  assign parser_mmio_rdata_d = (parser_off == 12'h100) ? parser_status
+                             : (parser_off >= 12'h200)  ? parser_meta_rd_data
+                             : 64'h0;
+  assign parser_mmio_rdata = parser_mmio_rdata_q;
+
+  always_ff @(posedge clk_i or negedge ndmreset_n) begin
+    if (!ndmreset_n) begin
+      // ParseLen defaults to the whole packet buffer — an unconfigured run parses the
+      // full window (matching the pre-I5 `parse_len_i = PKT_MAX` tie-off). A program
+      // that never writes 0x100 (e.g. the inline directed parser_insn.S) therefore does
+      // NOT see a 0-length packet (which would exit on op 0 and then deadlock the next
+      // inline custom-0 op via a_ready_low_when_done); the cosim overwrites it per case.
+      parser_parse_len_q  <= 16'(parser_pkg::PKT_MAX);
+      parser_exit_pc_q    <= '0;
+      parser_mmio_rdata_q <= '0;
+    end else begin
+      if (parser_wr_plen) parser_parse_len_q <= parser_mmio_wdata[15:0];
+      if (parser_wr_expc) parser_exit_pc_q   <= parser_mmio_wdata;
+      parser_mmio_rdata_q <= parser_mmio_rdata_d;   // 1-cycle read latency
+    end
+  end
+
   // ------------------------------
   // GPIO
   // ------------------------------
@@ -505,6 +584,7 @@ module ariane_testharness #(
     '{ idx: ariane_soc::SPI,      start_addr: ariane_soc::SPIBase,      end_addr: ariane_soc::SPIBase + ariane_soc::SPILength           },
     '{ idx: ariane_soc::Ethernet, start_addr: ariane_soc::EthernetBase, end_addr: ariane_soc::EthernetBase + ariane_soc::EthernetLength },
     '{ idx: ariane_soc::GPIO,     start_addr: ariane_soc::GPIOBase,     end_addr: ariane_soc::GPIOBase + ariane_soc::GPIOLength         },
+    '{ idx: ariane_soc::Parser,   start_addr: ariane_soc::ParserBase,   end_addr: ariane_soc::ParserBase + ariane_soc::ParserLength     },
     '{ idx: ariane_soc::DRAM,     start_addr: ariane_soc::DRAMBase,     end_addr: ariane_soc::DRAMBase + ariane_soc::DRAMLength         }
   };
 
@@ -649,7 +729,17 @@ module ariane_testharness #(
     .debug_req_i          ( debug_req_core      ),
 `endif
     .noc_req_o            ( axi_ariane_req      ),
-    .noc_resp_i           ( axi_ariane_resp     )
+    .noc_resp_i           ( axi_ariane_resp     ),
+    // parser MMIO (I5): packet-buffer write + ParseLen + flow_keys read
+    .parser_pkt_wr_en_i   ( parser_pkt_wr_en    ),
+    .parser_pkt_wr_addr_i ( parser_pkt_wr_addr  ),
+    .parser_pkt_wr_be_i   ( parser_pkt_wr_be    ),
+    .parser_pkt_wr_data_i ( parser_pkt_wr_data  ),
+    .parser_parse_len_i   ( parser_parse_len_q  ),
+    .parser_exit_pc_i     ( parser_exit_pc_q    ),
+    .parser_meta_rd_addr_i( parser_meta_rd_addr ),
+    .parser_meta_rd_data_o( parser_meta_rd_data ),
+    .parser_status_o      ( parser_status       )
   );
 
   `AXI_ASSIGN_FROM_REQ(slave[0], axi_ariane_req)
