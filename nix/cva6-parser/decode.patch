--- a/core/include/ariane_pkg.sv	1969-12-31 16:00:01.000000000 -0800
+++ b/core/include/ariane_pkg.sv	2026-08-15 23:16:38.262421804 -0700
@@ -196,7 +196,8 @@
     FPU,        // 7
     FPU_VEC,    // 8
     CVXIF,      // 9
-    ACCEL       // 10
+    ACCEL,      // 10
+    PARSER      // 11 - packet-parser FU (custom-0 in-pipeline / custom-3 coproc)
   } fu_t;
 
   // Index of writeback ports
@@ -496,7 +497,10 @@
     BREV8,
     // Zip instructions
     UNZIP,
-    ZIP
+    ZIP,
+    // Parser instructions (custom-0 in-pipeline / custom-3 coprocessor)
+    PARSER_C0,
