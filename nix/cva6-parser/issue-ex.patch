     assign x_valid_o        = '0;
   end
 
+  // ------------------------------------------------------------------
+  // PARSER functional unit (custom-0 in-pipeline / custom-3 coprocessor)
+  // ------------------------------------------------------------------
+  // The parser micro-op is decoded INSIDE the FU from the raw instruction word
+  // (parser_decode), executed by cva6_parser_wrap (which holds the persistent
+  // parser register state), against an in-core packet window (parser_pktbuf) and
+  // CAM (parser_cam). Packet/CAM *contents* are fed later (Phase 8 DMA / custom-3
+  // programming); here they are empty-backed, so the wiring elaborates and a
+  // custom-0 op issues → executes → retires. End-of-node redirect is muxed onto
+  // resolved_branch_o below. See docs/analysis/cva6-integration.md §3–§5.
+  begin : gen_parser
+    parser_pkg::micro_op_t parser_uop;
+    logic                  parser_dec_illegal;
+    logic [parser_pkg::PKT_OFF_W-1:0] parser_pkt_off;
+    logic [63:0]           parser_pkt_win_be;
+    logic [3:0]            parser_cam_share;
+    logic [15:0]           parser_cam_match;
+    logic                  parser_cam_hit;
+    logic [31:0]           parser_cam_target;
+    logic                  parser_parse_exit;
+    logic signed [31:0]    parser_parse_code;
+    bp_resolve_t           parser_bp_unused;
+
+    // decode the raw word -> micro-op
+    parser_decode u_parser_decode (
+        .word_i   (parser_off_instr_i),
+        .op_o     (parser_uop),
+        .illegal_o(parser_dec_illegal)
+    );
+
+    // in-core packet window + CAM (empty-backed for the slice)
+    parser_pktbuf u_parser_pktbuf (
+        .req_off_i(parser_pkt_off),
+        .win_be_o (parser_pkt_win_be)
+    );
+    parser_cam u_parser_cam (
+        .share_i (parser_cam_share),
+        .match_i (parser_cam_match),
+        .hit_o   (parser_cam_hit),
+        .target_o(parser_cam_target)
+    );
+
+    cva6_parser_wrap #(
+        .bp_resolve_t (bp_resolve_t),
+        .VLEN         (CVA6Cfg.VLEN),
+        .TRANS_ID_BITS(CVA6Cfg.TRANS_ID_BITS)
+    ) u_parser_fu (
+        .clk_i,
+        .rst_ni,
+        .flush_i,
+        .parser_valid_i   (|parser_valid_i),
+        // commit-visibility of parser state (I1): apply on commit, roll back on flush
+        .commit_i         (parser_commit_i),
+        .commit_trans_id_i(parser_commit_trans_id_i),
+        .uop_i            (parser_uop),
+        // parser is single-in-flight and issues on port 0 only (fus_busy[1].parser)
+        .trans_id_i       (fu_data_i[0].trans_id),
+        .pc_i             (pc_i),
+        .parse_len_i      (16'(parser_pkg::PKT_MAX)),  // provisional; real ParseLen via pkt buffer (Phase 8)
+        .parser_ready_o   (parser_ready_o),
+        .parser_valid_o   (parser_valid_o),
+        .parser_trans_id_o(parser_trans_id_o),
+        .parser_result_o  (parser_result_o),
+        .parser_we_o      (  /* custom-0 never writes integer rd */),
+        .resolved_branch_o(parser_bp_unused),
+        .resolve_branch_o (parser_resolve_branch),
+        .redirect_pc_o    (parser_redirect_pc),
+        .parse_exit_o     (parser_parse_exit),
+        .parse_code_o     (parser_parse_code),
+        .pkt_off_o        (parser_pkt_off),
+        .pkt_win_be_i     (parser_pkt_win_be),
+        .cam_share_o      (parser_cam_share),
+        .cam_match_o      (parser_cam_match),
+        .cam_hit_i        (parser_cam_hit),
+        .cam_target_i     (parser_cam_target)
+    );
+    // the parser drives no CPU exception (exits redirect via resolved_branch_o)
+    assign parser_exception_o = '0;
+  end
+
+  // Redirect mux: branch_unit and the parser are mutually exclusive by
+  // construction (in-order issue + single in-flight parser op), so OR the resolve
+  // strobes and select the parser's payload when it resolves (cva6-integration §4).
+  always_comb begin : gen_resolved_branch_mux
+    resolve_branch_o  = branch_resolve_branch | parser_resolve_branch;
+    resolved_branch_o = branch_resolved_branch;
+    if (parser_resolve_branch) begin
+      resolved_branch_o                = '0;
+      resolved_branch_o.valid          = 1'b1;
+      resolved_branch_o.pc             = pc_i;
+      resolved_branch_o.target_address = parser_redirect_pc;
+      resolved_branch_o.is_mispredict  = 1'b1;
+      resolved_branch_o.is_taken       = 1'b1;
+      resolved_branch_o.cf_type        = ariane_pkg::JumpR;
+    end
+  end
+
   if (CVA6Cfg.RVS) begin
     if (CVA6Cfg.RVH) begin
       always_ff @(posedge clk_i or negedge rst_ni) begin
