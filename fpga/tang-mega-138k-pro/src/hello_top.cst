//
// hello_top.cst — physical constraints for the UART hello-world design.
//
// Pins from Sipeed's vendor examples (nix build .#tang-mega-examples):
//   clk / led[5:0]  led/src/top.cst
//   uart_tx         pro_ddr_test/src/pro.cst  -> P15
//
// P15 goes to the on-board debugger's UART receive side, which surfaces on the
// host as the SECOND FT2232 interface, /dev/ttyUSB1 (interface A is JTAG).
// The matching RX pin (host -> FPGA) is still TBD; no vendor example we have
// drives one, so this design is transmit-only.
//
// Whole bank is 3.3 V. Do not exceed it.
//

// 50 MHz system clock.
IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// UART transmit, FPGA -> debugger.
IO_LOC "uart_tx_pin" P15;
IO_PORT "uart_tx_pin" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Six user LEDs, active low.
IO_LOC "led[5]" N23;
IO_LOC "led[4]" N21;
IO_LOC "led[3]" M25;
IO_LOC "led[2]" L20;
IO_LOC "led[1]" R26;
IO_LOC "led[0]" J14;

IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
