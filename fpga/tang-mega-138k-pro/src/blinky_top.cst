//
// blinky_top.cst — physical constraints for the Tang Mega 138K Pro.
//
// Pins transcribed from Sipeed's own led/src/top.cst in the pinned vendor
// examples (nix build .#tang-mega-examples), which is the only authority we have
// — the Sipeed wiki's peripheral table is wrong about these LEDs, calling them
// "6x WS2812 addressable RGB" when they are six plain GPIO pins.
//
// The whole bank is 3.3 V. Do NOT drive these pins above 3.3 V; the wiki is
// emphatic that overvoltage permanently damages the part.
//
// No reset pin here on purpose — see the header of blinky_top.v.
//

// 50 MHz system clock.
IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// Six user LEDs, active low.
IO_LOC "led[5]" N23;
IO_LOC "led[4]" N21;
IO_LOC "led[3]" M25;
IO_LOC "led[2]" L20;
IO_LOC "led[1]" R26;
IO_LOC "led[0]" J14;

IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
