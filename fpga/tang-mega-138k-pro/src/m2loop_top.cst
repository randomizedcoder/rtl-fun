//
// m2loop_top.cst — physical constraints for the M2 UART loopback (RX-pin confirm).
//
// The USB debug UART is transmit-only from fabric: its RX net (N16) is a dedicated CPU
// pin PnR refuses (ERROR PR2017). So M2 runs its UART over an EXTERNAL 3.3 V USB-TTL
// serial adapter wired to PMOD2 (bank 5, general user I/O, clear of the CPU pins):
//
//   uart_rx_pin  C21  PMOD2_IO0   <- adapter TX   (host -> FPGA)
//   uart_tx_pin  B20  PMOD2_IO1   -> adapter RX   (FPGA -> host)
//   GND          PMOD2 GND        <- adapter GND
//   (adapter VCC: LEAVE DISCONNECTED — the board is self-powered)
//
// !! The bank is 3.3 V. The adapter MUST be 3.3 V logic. 5 V (or true RS-232 +/-12 V)
//    on these pins permanently damages the FPGA. !!
//
// clk / led from the vendor led/src/top.cst.
//

// 50 MHz system clock.
IO_LOC "clk" P16;
IO_PORT "clk" PULL_MODE=NONE DRIVE=OFF BANK_VCCIO=3.3;

// UART over the external adapter on PMOD2 (bank 5).
IO_LOC "uart_rx_pin" C21;
IO_PORT "uart_rx_pin" PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC "uart_tx_pin" B20;
IO_PORT "uart_tx_pin" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;

// Six user LEDs, active low.
IO_LOC "led[5]" N23;
IO_LOC "led[4]" N21;
IO_LOC "led[3]" M25;
IO_LOC "led[2]" L20;
IO_LOC "led[1]" R26;
IO_LOC "led[0]" J14;

IO_PORT "led[5]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[4]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[3]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[2]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[1]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_PORT "led[0]" PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
